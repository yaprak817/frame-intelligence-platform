# Copy to .env.production (gitignored). Every value below is deliberately fake.
COMPOSE_PROJECT_NAME=frame-intelligence-production
APP_SITE=https://frames.example.invalid
STORAGE_SITE=https://storage.frames.example.invalid
OBJECT_STORAGE_EXTERNAL_ENDPOINT=https://storage.frames.example.invalid
PROXY_HTTP_BIND=80
PROXY_HTTPS_BIND=443
API_PROXY_TIMEOUT_SECONDS=30
UPLOAD_PROXY_TIMEOUT_SECONDS=1800
MIGRATION_LOCK_TIMEOUT_SECONDS=60
INTERNAL_PROXY_SHARED_SECRET=replace_with_at_least_32_random_characters

POSTGRES_DB=frame_intelligence
POSTGRES_USER=replace_with_random_database_user
POSTGRES_PASSWORD=replace_with_at_least_32_random_characters
JOB_SOURCE_ENCRYPTION_KEY=replace_with_urlsafe_base64_encoding_of_32_random_bytes

MINIO_ROOT_USER=replace_with_random_storage_access_key
MINIO_ROOT_PASSWORD=replace_with_at_least_32_random_characters
MINIO_BUCKET=frame-intelligence
OBJECT_STORAGE_REGION=us-east-1

RATE_LIMIT_SUBMISSION_REQUESTS=10
RATE_LIMIT_RESULT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
