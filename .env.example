# Application
APP_NAME=Frame Intelligence API
APP_VERSION=0.1.0
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=frame_intelligence
POSTGRES_USER=frame_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://frame_user:change_me@postgres:5432/frame_intelligence

# URL-safe base64 encoding of exactly 32 random bytes. Generate outside the repo.
JOB_SOURCE_ENCRYPTION_KEY=replace_with_urlsafe_base64_32_byte_key

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_VISIBILITY_TIMEOUT_SECONDS=7200
CELERY_WORKER_CONCURRENCY=1

# Transactional outbox publisher
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=10
OUTBOX_BACKOFF_BASE_SECONDS=1
OUTBOX_BACKOFF_MAX_SECONDS=60

# Worker execution lease (heartbeat must be less than half the lease)
JOB_LEASE_SECONDS=900
JOB_HEARTBEAT_INTERVAL_SECONDS=60
MAX_DOWNLOAD_BYTES=2147483648
PROCESSING_TEMP_ROOT=/tmp/frame-intelligence

# Object Storage
MINIO_ROOT_USER=frame_admin
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=frame-intelligence
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=frame_admin
OBJECT_STORAGE_SECRET_KEY=change_me
OBJECT_STORAGE_BUCKET=frame-intelligence
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ADDRESSING_STYLE=path
MAX_UPLOAD_BYTES=2147483648
OBJECT_STORAGE_MULTIPART_CHUNK_BYTES=8388608
