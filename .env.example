# Application
APP_NAME=Frame Intelligence API
APP_VERSION=0.1.0
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=false
# JSON array of proxy CIDRs allowed to supply X-Forwarded-For. Empty is safest.
TRUSTED_PROXY_CIDRS=[]

# Frontend server-side proxy target. Never expose this as NEXT_PUBLIC_*.
BACKEND_INTERNAL_URL=http://backend:8000

# PostgreSQL
POSTGRES_DB=frame_intelligence
POSTGRES_USER=frame_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://frame_user:change_me@postgres:5432/frame_intelligence

# URL-safe base64 encoding of exactly 32 random bytes. Generate outside the repo.
JOB_SOURCE_ENCRYPTION_KEY=replace_with_urlsafe_base64_32_byte_key

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_VISIBILITY_TIMEOUT_SECONDS=7200
CELERY_WORKER_CONCURRENCY=1
RATE_LIMIT_SUBMISSION_REQUESTS=10
RATE_LIMIT_RESULT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
DEPENDENCY_TIMEOUT_SECONDS=2
FRAME_EXPORT_MAX_FRAMES=1000
FRAME_EXPORT_MAX_TOTAL_BYTES=2147483648
FRAME_EXPORT_MAX_ZIP_BYTES=2147483648
FRAME_EXPORT_MAX_TEMP_BYTES=2200000000
FRAME_EXPORT_MIN_TEMP_FREE_BYTES=268435456
FRAME_EXPORT_LEASE_SECONDS=300
FRAME_EXPORT_HEARTBEAT_INTERVAL_SECONDS=30
FRAME_EXPORT_SOFT_TIME_LIMIT_SECONDS=1800
FRAME_EXPORT_HARD_TIME_LIMIT_SECONDS=1860
FRAME_EXPORT_S3_CONNECT_TIMEOUT_SECONDS=5
FRAME_EXPORT_S3_READ_TIMEOUT_SECONDS=30
FRAME_EXPORT_STALE_TEMP_SECONDS=7200
IMAGE_DATASET_MAX_FILES=1000
IMAGE_DATASET_MAX_IMAGES=1000
IMAGE_DATASET_MAX_FILE_BYTES=52428800
IMAGE_DATASET_MAX_TOTAL_BYTES=2147483648
IMAGE_DATASET_MAX_PIXELS=100000000
IMAGE_DATASET_MIN_PIXELS=1024
IMAGE_DATASET_ZIP_MAX_ENTRIES=1200
IMAGE_DATASET_ZIP_MAX_COMPRESSED_BYTES=2147483648
RESULT_ARTIFACT_SPOOL_MIN_FREE_BYTES=268435456
IMAGE_DATASET_ZIP_MAX_ENTRY_COMPRESSED_BYTES=52428800
IMAGE_DATASET_ZIP_MAX_UNCOMPRESSED_BYTES=2147483648
IMAGE_DATASET_ZIP_MAX_RATIO=100
IMAGE_DATASET_EXPORT_MAX_BYTES=2147483648
IMAGE_DATASET_NORMAL_SHARPNESS=100
IMAGE_DATASET_UNUSABLE_SHARPNESS=5
IMAGE_DATASET_MIN_BRIGHTNESS=35
IMAGE_DATASET_MAX_BRIGHTNESS=225
IMAGE_DATASET_UNUSABLE_BRIGHTNESS=5
IMAGE_DATASET_SOFT_TIME_LIMIT_SECONDS=1800
IMAGE_DATASET_HARD_TIME_LIMIT_SECONDS=1860
IMAGE_DATASET_MAX_TEMP_BYTES=4400000000
IMAGE_DATASET_MIN_TEMP_FREE_BYTES=268435456

# Transactional outbox publisher
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=10
OUTBOX_BACKOFF_BASE_SECONDS=1
OUTBOX_BACKOFF_MAX_SECONDS=60

# Worker execution lease (heartbeat must be less than half the lease)
JOB_LEASE_SECONDS=900
JOB_HEARTBEAT_INTERVAL_SECONDS=60
MAX_DOWNLOAD_BYTES=2147483648
PROCESSING_TEMP_ROOT=/tmp/frame-intelligence

# Object Storage
MINIO_ROOT_USER=frame_admin
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=frame-intelligence
OBJECT_STORAGE_ENDPOINT=http://minio:9000
# Browser/client reachable endpoint used to generate presigned result URLs.
# It must address the same private bucket as OBJECT_STORAGE_ENDPOINT.
OBJECT_STORAGE_EXTERNAL_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=frame_admin
OBJECT_STORAGE_SECRET_KEY=change_me
OBJECT_STORAGE_BUCKET=frame-intelligence
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ADDRESSING_STYLE=path
MAX_UPLOAD_BYTES=2147483648
OBJECT_STORAGE_MULTIPART_CHUNK_BYTES=8388608
RESULT_ARTIFACT_URL_TTL_SECONDS=300
